# Optional stability tuning for large bots
BOT_WORKERS=32
BOT_SLEEP_THRESHOLD=30
MAX_MESSAGE_CACHE_SIZE=10000
BIO_CACHE_TTL=60
CLEAN_BIO_CACHE_TTL=10
LINK_BIO_CACHE_TTL=20
PROFILE_FETCH_CONCURRENCY=8
MAX_FLOOD_WAIT=60
LOCAL_CACHE_MAX_SIZE=50000
TELEGRAM_WRITE_CONCURRENCY=16
PENALTY_CACHE_TTL=600
WARNING_NOTICE_COOLDOWN=3
BROADCAST_CONCURRENCY=3
BROADCAST_DELAY_MS=150
CHAT_REGISTER_CACHE_TTL=300
